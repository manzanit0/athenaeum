# Supply chain defaults for this project, so they also hold inside the
# Docker build where the developer's own ~/.npmrc is not present.
# ignore-scripts keeps dependencies from running install scripts.
ignore-scripts=true
save-exact=true
# Honoured by npm 11.10 and later only; the node:22 image used by the
# Dockerfile ships an older npm and ignores it with a warning.
min-release-age=3
